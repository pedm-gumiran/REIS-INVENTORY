{
  "name": "reis-inventory",
  "version": "1.0.0",
  "description": "Inventory System Desktop App",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && npm run dev",
    "dev": "concurrently --kill-others-on-fail -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "build-frontend": "cd frontend && npm run build",
    "start": "electron .",
    "dist": "npm run build-frontend && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.reis.inventory",
    "productName": "Reis Inventory System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "frontend/public/reims-logo.png",
      "frontend/public/reims-logo.png",
      "package.json",
      "backend/.env"
    ],
    "icon": "frontend/public/reims-logo.png",
    "win": {
      "target": "nsis",
      "icon": "frontend/public/reims-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
